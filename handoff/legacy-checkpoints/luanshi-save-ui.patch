+			return false
+		for field in ["surviving_ids", "dead_ids", "wounded", "missing", "captured"]:
+			if not array(force[field], 20): return false
+			for id in force[field]:
+				if not text(id): return false
+	return true
+
+static func receipt(value: Variant) -> bool:
+	return keys(value, ["ok", "already_committed", "battle_id", "result", "depot_captured", "campaign_ended", "elapsed_world_time", "spoils"]) and value.ok is bool and value.already_committed is bool and text(value.battle_id) and value.result in ["victory", "retreat", "commander_dead"] and value.depot_captured is bool and value.campaign_ended is bool and number(value.elapsed_world_time, 0, 8760 * 3600.0) and keys(value.spoils, ["weapons"]) and integer(value.spoils.weapons, 0, 20)
