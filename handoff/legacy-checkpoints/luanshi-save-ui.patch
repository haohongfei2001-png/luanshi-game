 func settle() -> Dictionary:
 	if simulation == null:
 		return {"ok": false, "reason": "no_battle"}
+	if world.battle_ticket(ticket.battle_id).get("status") != "committed" and not world.is_current_battle(ticket.battle_id, simulation):
