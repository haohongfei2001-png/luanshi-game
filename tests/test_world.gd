extends SceneTree

const Simulation := preload("res://scripts/world_sim.gd")
var assertions := 0
var failures: Array[String] = []

func _initialize() -> void:
	call_deferred("_run")

func check(condition: bool, message: String) -> void:
	assertions += 1
	if not condition:
		failures.append(message)
		push_error("FAIL: " + message)

func tick_checked(sim: RefCounted, hours: int) -> void:
	for tick in range(hours):
		check(sim.advance(1), "hour advances")
		check(sim.audit().is_empty(), "conservation at hour %d: %s" % [tick + 1, sim.audit()])

func _run() -> void:
	var baseline := Simulation.new(184)
	check(baseline.snapshot().cities.size() == 3 and baseline.snapshot().factions.size() == 2, "three cities, two factions")
	check(baseline.snapshot().armies.relief.soldiers == 60 and baseline.snapshot().armies.relief.weapons == 30, "real unequipped starting soldiers")
	check(baseline.audit().is_empty(), "initial conservation")
	check(baseline.player_view().known.anping.observed_at == -72, "initial report is three days old")
	check(not baseline.player_view().has("cities") and not baseline.player_view().has("pending_reports"), "view excludes truth and future reports")

	var timely := Simulation.new(184)
	check(timely.march("road"), "direct relief accepted")
	check(timely.snapshot().armies.relief.location == "", "marching army has no city location")
	check(not timely.march("mountain"), "cannot overwrite active march")
	tick_checked(timely, 6)
	var truth: Dictionary = timely.snapshot()
	check(truth.siege.outcome == "relieved" and truth.cities.anping.owner == "sheng", "timely actual force saves city")
	check(truth.armies.relief.soldiers == 53 and truth.armies.relief.food == 84, "relief costs seven soldiers and 36 rations")
	check(truth.armies.besiegers.soldiers == 71 and not truth.armies.besiegers.march.is_empty(), "enemy casualties and retreat are persistent")
	check(timely.player_view().known.anping.contents.under_siege, "outcome does not silently leak into old report")
	print("SCENARIO timely: hour=6 owner=sheng outcome=relieved relief=53 food=84")

	var late := Simulation.new(184)
	tick_checked(late, 10)
	check(late.march("road"), "delayed direct march")
	tick_checked(late, 5)
	truth = late.snapshot()
	check(truth.siege.outcome == "captured" and truth.cities.anping.owner == "bei", "city falls off-screen before arrival")
	check(not truth.armies.relief.march.is_empty(), "late troops still in transit at fall")
	check(truth.ledger.prisoners == 40, "surrendered garrison accounted as prisoners")
	check(late.player_view().known.anping.contents.owner == "sheng", "old owner remains reported until messenger arrives")
	tick_checked(late, 1)
	check(late.snapshot().armies.relief.location == "anping" and late.snapshot().siege.outcome == "captured", "arrival cannot retroactively rewrite defeat")
	check(late.observe_city("anping"), "physical presence permits fresh observation")
	check(late.player_view().known.anping.contents.owner == "bei", "fresh observation updates knowledge")
	tick_checked(late, 11)
	check(late.player_view().known.anping.observed_at == 16, "older messenger cannot overwrite more recent observation")
	print("SCENARIO late: fall=15 arrival=16 owner=bei prisoners=40")

	var interception := Simulation.new(184)
	check(not interception.seize_depot(), "remote interception forbidden")
	check(interception.march("river"), "river march accepted")
	tick_checked(interception, 3)
	var food_before: int = interception.totals().food
	check(interception.seize_depot(), "superior local troops take depot")
	check(not interception.seize_depot(), "capturing twice cannot create loot or losses")
	check(interception.totals().food == food_before, "capturing changes ownership, not quantity")
	check(interception.snapshot().armies.relief.soldiers == 56, "interception costs four soldiers")
	check(interception.snapshot().ledger.prisoners == 15, "depot defenders are accounted")
	tick_checked(interception, 7)
	truth = interception.snapshot()
	check(truth.siege.outcome == "supply_retreat" and truth.cities.anping.owner == "sheng", "cut actual stocks forces retreat before city falls")
	check(truth.armies.relief.location == "hequ" and truth.armies.besiegers.food == 0, "indirect relief is actual hunger, not relief presence")
	check(truth.cities.hequ.food > 0, "captured food cannot teleport to hostile army")
	print("SCENARIO interception: capture=3 retreat=10 owner=sheng relief=56 enemy_food=0")

	var mountain := Simulation.new(184)
	check(mountain.march("mountain"), "mountain route accepted")
	tick_checked(mountain, 18)
	check(mountain.snapshot().siege.outcome == "captured", "same departure, slower route loses city")
	check(mountain.snapshot().armies.relief.food == 12, "long route has real ration cost")

	var convoy_test := Simulation.new(184)
	tick_checked(convoy_test, 1)
	var first_convoy: Dictionary = convoy_test.snapshot().convoys[0]
	check(first_convoy.food == 8 and first_convoy.owner == "bei", "convoy owns eight real ration units")
	check(first_convoy.departed_at == 1 and first_convoy.arrives_at == 6, "convoy takes the full five-hour road")
	check(convoy_test.snapshot().armies.besiegers.food == 40, "new dispatch does not teleport to army")
	tick_checked(convoy_test, 4)
	check(convoy_test.snapshot().convoys.size() == 5 and convoy_test.snapshot().armies.besiegers.food == 8, "five shipments remain in transit before first delivery")
	tick_checked(convoy_test, 1)
	check(convoy_test.snapshot().armies.besiegers.food == 8, "first shipment arrives and is consumed at hour six")
	check(convoy_test.snapshot().convoys[0].id == 2, "only due shipment removed from transit")
	var cut := Simulation.new(184)
	cut.march("river")
	cut.advance(3)
	check(cut.snapshot().convoys.size() == 3, "three shipments departed before capture")
	cut.seize_depot()
	check(cut.snapshot().convoys.size() == 3, "depot capture does not erase departed cargo")
	tick_checked(cut, 3)
	check(cut.snapshot().convoys.size() == 2 and cut.snapshot().next_convoy == 4, "old shipment delivers after capture, new dispatches stop")
	var returning := Simulation.new(184)
	returning.march("road")
	returning.advance(6)
	check(returning.snapshot().convoys.size() == 5, "relief leaves real cargo in transit")
	tick_checked(returning, 1)
	check(returning.snapshot().convoys[0].returning and returning.snapshot().convoys[0].arrives_at == 12, "supply for withdrawn enemy returns along five-hour road")
	check(returning.snapshot().cities.anping.food == 72, "enemy cargo not gifted to friendly relieved city")
	tick_checked(returning, 9)
	check(returning.snapshot().convoys.is_empty(), "all returning cargo eventually reaches depot without disappearing")
	check(returning.audit().is_empty(), "returning cargo conserves food including starvation losses")
	check(baseline.player_view().local_city.id == "pingling" and baseline.player_view().local_city.food == 500, "local city inventory is visible")
	check(timely.player_view().local_city.id == "anping", "local information follows actual arrival")
	var local_view: Dictionary = baseline.player_view()
	local_view.local_city.food = 99999
	check(baseline.snapshot().cities.pingling.food == 500, "local city view is detached")
	baseline.march("road")
	check(baseline.player_view().local_city.is_empty(), "transit view cannot inspect remote cities")

	var no_interception := Simulation.new(184)
	no_interception.march("river")
	tick_checked(no_interception, 15)
	check(no_interception.snapshot().siege.outcome == "captured", "river route alone is not a scripted win")
	check(no_interception.snapshot().cities.hequ.food < interception.snapshot().cities.hequ.food, "unseized depot actually feeds besiegers")

	var unarmed := Simulation.new(184)
	check(unarmed.transfer("relief", "pingling", "weapons", 30), "weapons can be left behind but remain real inventory")
	unarmed.march("road")
	tick_checked(unarmed, 6)
	check(unarmed.snapshot().siege.active, "same timely arrival without weapons is insufficient: not an option-driven victory")
	tick_checked(unarmed, 19)
	check(unarmed.snapshot().siege.outcome == "captured", "unsupported relief cannot prevent hunger-driven surrender")

	var inventory := Simulation.new(184)
	var initial: Dictionary = inventory.totals()
	check(inventory.transfer("pingling", "relief", "weapons", 20), "local allied weapon transfer")
	check(inventory.snapshot().cities.pingling.weapons == 0 and inventory.snapshot().armies.relief.weapons == 50, "weapons subtracted and allocated")
	check(inventory.totals() == initial, "transfer conserves inventory")
	check(not inventory.transfer("pingling", "relief", "weapons", 1), "no weapons from empty inventory")
	check(not inventory.transfer("hequ", "relief", "food", 1), "no hostile/remote transfer")
	check(not inventory.transfer("anping", "relief", "food", 1), "no allied remote teleport")
	check(not inventory.transfer("relief", "relief", "food", 1), "no self transfer")
	check(not inventory.transfer("missing", "relief", "food", 1), "invalid entity rejected")
	check(not inventory.transfer("pingling", "relief", "soldiers", 1), "unsupported resource rejected")
	check(not inventory.transfer("pingling", "relief", "food", 0), "zero transfer rejected")
	check(not inventory.transfer("pingling", "relief", "food", -1), "negative transfer rejected")
	check(not inventory.march("missing") and not inventory.march("grain_road"), "invalid or disconnected route rejected")
	check(not inventory.observe_city("anping") and not inventory.observe_city("missing"), "remote and nonexistent scouting rejected")
	check(not inventory.observe_city("pingling", -1), "negative delay rejected")
	var saved := JSON.stringify(inventory.snapshot())
	check(not inventory.advance(-1) and not inventory.advance(Simulation.MAX_ADVANCE + 1), "invalid clock advances rejected")
	check(inventory.advance(0) and JSON.stringify(inventory.snapshot()) == saved, "invalid and zero advances leave world unchanged")
	check(inventory.observe_city("pingling", 4), "delayed local observation queued")
	check(not inventory.player_view().known.has("pingling"), "observation not delivered early")
	tick_checked(inventory, 3)
	check(not inventory.player_view().known.has("pingling"), "observation still pending one hour before arrival")
	tick_checked(inventory, 1)
	var report: Dictionary = inventory.player_view().known.pingling
	check(report.observed_at == 0 and report.reported_at == 4 and report.source == "亲历斥候", "report preserves source, observation and delivery clocks")
	check(report.contents.food == 500 and inventory.snapshot().cities.pingling.food == 508, "stale report contents frozen despite later production")
	var detached: Dictionary = inventory.snapshot()
	detached.armies.relief.food = 99999
	check(inventory.snapshot().armies.relief.food != 99999, "snapshot cannot mutate truth")
	var view: Dictionary = inventory.player_view()
	view.army.soldiers = 99999
	check(inventory.snapshot().armies.relief.soldiers == 60, "view cannot mutate truth")
	var parsed: Variant = JSON.parse_string(JSON.stringify(inventory.snapshot()))
	check(parsed is Dictionary and parsed.armies.relief.soldiers == 60 and parsed.reports.size() == 2, "snapshot contains only JSON-compatible state")

	var repeat := Simulation.new(184)
	repeat.march("river")
	repeat.advance(3)
	repeat.seize_depot()
	repeat.advance(7)
	check(JSON.stringify(repeat.snapshot()) == JSON.stringify(interception.snapshot()), "same seed and actions reproduce entire state and messages")
	var batched := Simulation.new(184)
	batched.march("mountain")
	batched.advance(18)
	check(JSON.stringify(batched.snapshot()) == JSON.stringify(mountain.snapshot()), "hourly and batched advancing are equivalent")
	var long_run := Simulation.new(1)
	tick_checked(long_run, 96)
	check(long_run.snapshot().ledger.weapons_produced > 0, "daily weapon production is ledgered")
	check(long_run.snapshot().armies.relief.soldiers < 60, "prolonged starvation has real casualties")
	check(long_run.snapshot().siege.outcome == "captured", "off-screen result persists")
	print("World tests: %d assertions, %d failures" % [assertions, failures.size()])
	quit(0 if failures.is_empty() else 1)
