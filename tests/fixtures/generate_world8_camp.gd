extends SceneTree
const W := preload("res://scripts/world_sim.gd")
const Store := preload("res://scripts/campaign_store.gd")
const Driver := preload("res://tests/youth_combat_driver.gd")
func _initialize() -> void:
	var w := W.new(184)
	assert(w.start_youth("forced", "homeland").ok)
	for action in ["arrange_courier", "first_march", "wait_courier", "courier_comply"]: assert(w.youth_action(action).ok)
	var ticket := w.create_battle_ticket()
	assert(ticket.ok)
	assert(w.commit_battle_outcome(Driver.play(w.start_battle(ticket.ticket.battle_id))).ok)
	for action in ["return_to_camp", "keep_evidence", "accept_appointment"]: assert(w.youth_action(action).ok)
	var encoded := Store.new().encode_campaign(w)
	assert(encoded.ok)
	var file := FileAccess.open(OS.get_cmdline_user_args()[0], FileAccess.WRITE)
	file.store_buffer(encoded.bytes)
	file.close()
	print("GENUINE_WORLD8_FIXTURE_PASS ", w.snapshot().version, " ", w.snapshot().youth.stage)
	quit()
