extends SceneTree
## Preserve original full source as LOD0; engine simplification retains attributes.
const Native:=preload("res://tools/art/sprite_source/assemble_woodland_region.gd")
func _initialize():run.call_deferred()
func run():
 var args:=OS.get_cmdline_user_args();assert(args.size()==2)
 var receipt:Dictionary=JSON.parse_string(FileAccess.get_file_as_string(args[0].get_base_dir().path_join("restoration.json")))
 assert(receipt.files.size()==11 and receipt.license=="CC0-1.0")
 for f:Dictionary in receipt.files:assert(FileAccess.get_sha256(args[0].get_base_dir().path_join(str(f.path)))==str(f.sha256))
 var scene:=Native.load_native(args[0]);var report:=[]
 for node:MeshInstance3D in scene.find_children("*","MeshInstance3D",true,false):
  var source:=node.mesh;var importer:=ImporterMesh.new()
  for surface in source.get_surface_count():
   importer.add_surface(Mesh.PRIMITIVE_TRIANGLES,source.surface_get_arrays(surface),[],{},source.surface_get_material(surface))
  importer.generate_lods(60.,25.,[])
  for surface in source.get_surface_count():
   var levels:=[]
   for level in importer.get_surface_lod_count(surface):levels.append({"triangles":importer.get_surface_lod_indices(surface,level).size()/3,"screen_error":importer.get_surface_lod_size(surface,level)})
   report.append({"surface":surface,"lod0_triangles":source.surface_get_arrays(surface)[Mesh.ARRAY_INDEX].size()/3,"generated_lods":levels})
  node.mesh=importer.get_mesh();node.mesh.resource_local_to_scene=false
 var packed:=PackedScene.new();assert(packed.pack(scene)==OK);assert(ResourceSaver.save(packed,args[1])==OK)
 FileAccess.open(args[1]+".json",FileAccess.WRITE).store_string(JSON.stringify({"output_sha256":FileAccess.get_sha256(args[1]),"source":FileAccess.get_sha256(args[0]),"surfaces":report,"visual_acceptance":"NOT_RUN","source_geometry":"full LOD0 retained; lower indices generated by Godot ImporterMesh"},"  "))
 print("ORIGINAL_TREE_LODS_GENERATED ",JSON.stringify(report));scene.free();quit()
