diff --git a/drivers/gles3/shaders/skeleton.glsl b/drivers/gles3/shaders/skeleton.glsl
index 66befbc..f78aa4f 100644
--- a/drivers/gles3/shaders/skeleton.glsl
+++ b/drivers/gles3/shaders/skeleton.glsl
@@ -40,11 +40,12 @@ layout(location = 1) in highp uvec2 in_normal;
 layout(location = 2) in highp uvec2 in_tangent;
 #endif
 #else // MODE_BLEND_PASS
-#ifdef USE_NORMAL
-layout(location = 1) in highp vec2 in_normal;
-#endif
-#ifdef USE_TANGENT
-layout(location = 2) in highp vec2 in_tangent;
+// Base mesh VAOs pack both octahedral attributes at location 1. Location 2
+// is intentionally disabled by MeshStorage's regular mesh VAO layout.
+#if defined(USE_NORMAL) || defined(USE_TANGENT)
+layout(location = 1) in highp vec4 in_normal_tangent;
+#define in_normal in_normal_tangent.xy
+#define in_tangent in_normal_tangent.zw
 #endif
 #endif // MODE_BLEND_PASS
 
@@ -118,12 +119,15 @@ vec2 vec3_to_oct(vec3 e) {
 
 vec4 oct_to_tang(vec2 oct_sign_encoded) {
 	// Binormal sign encoded in y component
-	vec2 oct = vec2(oct_sign_encoded.x, abs(oct_sign_encoded.y) * 2.0 - 1.0);
-	return vec4(oct_to_vec3(oct), sign(oct_sign_encoded.y));
+	float signed_y = oct_sign_encoded.y * 2.0 - 1.0;
+	vec2 oct = vec2(oct_sign_encoded.x, abs(signed_y));
+	return vec4(oct_to_vec3(oct), sign(signed_y));
 }
 
 vec2 tang_to_oct(vec4 base) {
 	vec2 oct = vec3_to_oct(base.xyz);
+	// Match Vector3::octahedron_tangent_encode: keep handedness away from zero.
+	oct.y = max(oct.y, 1.0 / 32767.0);
 	// Encode binormal sign in y component
 	oct.y = oct.y * 0.5f + 0.5f;
 	oct.y = base.w >= 0.0f ? oct.y : 1.0 - oct.y;
