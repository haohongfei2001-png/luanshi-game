+// Local Godot 4.6.3 tooling: EGL surfaceless software rendering.
+// Distributed under the same MIT license as Godot (see LICENSE.txt).
+#pragma once
+
+#include "servers/display/display_server_headless.h"
+#include "core/os/mutex.h"
+#include "thirdparty/glad/glad/egl.h"
+
+// Reuse no-desktop/input stubs only. This driver never selects RasterizerDummy.
+class DisplayServerSurfaceless : public DisplayServerHeadless {
+    GDSOFTCLASS(DisplayServerSurfaceless, DisplayServerHeadless);
+    void *egl_library = nullptr;
+    EGLDisplay egl_display = EGL_NO_DISPLAY;
+    EGLContext egl_context = EGL_NO_CONTEXT;
+    EGLSurface egl_surface = EGL_NO_SURFACE;
+    EGLConfig egl_config = nullptr;
+    bool initialized = false;
+    bool glad_loaded = false;
+    mutable Mutex size_mutex;
+    Size2i requested_size = Size2i(1280, 720);
+    Size2i surface_size;
+    ObjectID instance_id;
+    Callable rect_changed;
+
+    Error initialize_egl();
+    Error ensure_surface();
+    static Vector<String> get_rendering_drivers_func();
+    static DisplayServer *create_func(const String &, WindowMode, VSyncMode, uint32_t, const Vector2i *, const Vector2i &, int, Context, int64_t, Error &);
+
+public:
+    static void register_surfaceless_driver();
+    String get_name() const override { return "surfaceless"; }
+    int get_screen_count() const override { return 1; }
+    int window_get_current_screen(WindowID = MAIN_WINDOW_ID) const override { return 0; }
+    Size2i screen_get_size(int = SCREEN_OF_MAIN_WINDOW) const override { return window_get_size(); }
+    Rect2i screen_get_usable_rect(int = SCREEN_OF_MAIN_WINDOW) const override { return Rect2i(Point2i(), window_get_size()); }
+    Vector<WindowID> get_window_list() const override { Vector<WindowID> ids; ids.push_back(MAIN_WINDOW_ID); return ids; }
+    WindowID create_sub_window(WindowMode, VSyncMode, uint32_t, const Rect2i & = Rect2i(), bool = false, WindowID = INVALID_WINDOW_ID) override { return INVALID_WINDOW_ID; }
+    void window_attach_instance_id(ObjectID p_id, WindowID = MAIN_WINDOW_ID) override { instance_id = p_id; }
+    ObjectID window_get_attached_instance_id(WindowID = MAIN_WINDOW_ID) const override { return instance_id; }
+    void window_set_rect_changed_callback(const Callable &p_callable, WindowID = MAIN_WINDOW_ID) override { rect_changed = p_callable; }
+    void window_set_size(const Size2i, WindowID = MAIN_WINDOW_ID) override;
+    Size2i window_get_size(WindowID = MAIN_WINDOW_ID) const override;
+    Size2i window_get_size_with_decorations(WindowID = MAIN_WINDOW_ID) const override { return window_get_size(); }
+    WindowMode window_get_mode(WindowID = MAIN_WINDOW_ID) const override { return WINDOW_MODE_WINDOWED; }
+    VSyncMode window_get_vsync_mode(WindowID = MAIN_WINDOW_ID) const override { return VSYNC_DISABLED; }
+    bool window_can_draw(WindowID p_window = MAIN_WINDOW_ID) const override { return initialized && p_window == MAIN_WINDOW_ID; }
+    bool can_any_window_draw() const override { return initialized; }
+    int64_t window_get_native_handle(HandleType, WindowID = MAIN_WINDOW_ID) const override;
+    void gl_window_make_current(WindowID) override;
+    void release_rendering_thread() override;
+    void swap_buffers() override;
+    explicit DisplayServerSurfaceless(const Size2i &, Error &);
+    ~DisplayServerSurfaceless();
+};
